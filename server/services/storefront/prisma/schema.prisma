generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_credentials {
  user_id       String   @id @db.Char(36)
  password_hash String   @db.VarChar(255)
  updated_at    DateTime @default(now()) @db.DateTime(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_admin_credentials_user")
}

model audit_logs {
  id              String        @id @db.Char(36)
  organization_id String        @db.Char(36)
  actor_user_id   String?       @db.Char(36)
  branch_id       String?       @db.Char(36)
  action          String        @db.VarChar(128)
  entity_type     String        @db.VarChar(128)
  entity_id       String        @db.Char(36)
  before_data     Json?
  after_data      Json?
  ip_address      String?       @db.VarChar(45)
  device_id       String?       @db.VarChar(128)
  created_at      DateTime      @db.DateTime(6)
  users           users?        @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_audit_logs_actor_user_id")
  branches        branches?     @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_audit_logs_branch_id")
  organizations   organizations @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "fk_audit_logs_organization_id")

  @@index([actor_user_id, created_at], map: "idx_audit_actor")
  @@index([branch_id, created_at], map: "idx_audit_branch")
  @@index([organization_id, entity_type, entity_id, created_at], map: "idx_audit_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branches {
  id                                                       String                @id @db.Char(36)
  organization_id                                          String                @db.Char(36)
  code                                                     String                @db.VarChar(64)
  name                                                     String                @db.VarChar(255)
  address                                                  String?               @db.VarChar(500)
  phone                                                    String?               @db.VarChar(32)
  timezone                                                 String                @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  status                                                   String                @default("ACTIVE") @db.VarChar(32)
  created_at                                               DateTime              @default(now()) @db.DateTime(6)
  updated_at                                               DateTime              @default(now()) @db.DateTime(6)
  audit_logs                                               audit_logs[]
  organizations                                            organizations         @relation(fields: [organization_id], references: [id], onUpdate: NoAction, map: "fk_branches_organization_id")
  carts                                                    carts[]
  document_sequences                                       document_sequences[]
  goods_receipts                                           goods_receipts[]
  inventory_movements                                      inventory_movements[]
  orders                                                   orders[]
  pos_devices                                              pos_devices[]
  pos_shifts                                               pos_shifts[]
  purchase_orders                                          purchase_orders[]
  sales                                                    sales[]
  sales_returns                                            sales_returns[]
  stock_adjustments                                        stock_adjustments[]
  stock_counts                                             stock_counts[]
  stock_transfers_stock_transfers_from_branch_idTobranches stock_transfers[]     @relation("stock_transfers_from_branch_idTobranches")
  stock_transfers_stock_transfers_to_branch_idTobranches   stock_transfers[]     @relation("stock_transfers_to_branch_idTobranches")
  supplier_returns                                         supplier_returns[]
  user_branch_access                                       user_branch_access[]
  warehouses                                               warehouses[]

  @@unique([organization_id, code], map: "uq_branches_01")
  @@unique([organization_id, id], map: "uq_branches_org_id")
  @@index([organization_id, status], map: "idx_branches_org_status")
}

