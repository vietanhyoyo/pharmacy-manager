    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
